# PROOF Configuration

# Backend
DATABASE_URL=postgresql://username:password@localhost:5432/proof_db
# Or SQLite: sqlite:///./proof.db
SECRET_KEY=your_jwt_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# GitHub Integration (Optional - Fallback to demo mode if blank)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Supabase Storage Configuration (Backend only - Never expose to frontend)
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=reel-media

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

